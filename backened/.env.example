# Server Port
PORT=5001

# MongoDB Connection String (e.g. from MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/convocam?retryWrites=true&w=majority

# JWT Secret Key for token signing
JWT_SECRET_KEY=your_super_secret_jwt_key_here

# Google Gemini AI API Key (for Smart Replies & Translations)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Cloudinary Credentials (for image & file uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend / Client URL for CORS
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Environment (development | production)
NODE_ENV=development
